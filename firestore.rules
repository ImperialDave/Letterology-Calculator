rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function handleDoc(slug) {
      return /databases/$(database)/documents/handles/$(slug);
    }

    // The slug document must already be committed. get() does not see
    // a create in the same transaction, so the client writes the slug first.
    function ownsHandle(slug) {
      return slug is string
        && slug.size() > 0
        && slug.size() < 81
        && exists(handleDoc(slug))
        && get(handleDoc(slug)).data.uid == request.auth.uid;
    }

    function sourceOk() {
      return request.resource.data.source in ['google', 'apple', 'x', 'linked'];
    }

    match /users/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && ownsHandle(request.resource.data.handle)
        && sourceOk()
        && request.resource.data.createdAt is number;

      allow update: if owns(uid)
        && ownsHandle(request.resource.data.handle)
        && sourceOk()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if owns(uid);
    }

    match /handles/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt']);
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
