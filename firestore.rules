rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function handleDoc(slug) {
      return /databases/$(database)/documents/handles/$(slug);
    }

    // The slug document must already be committed. get() does not see
    // a create in the same transaction, so the client writes the slug first.
    function ownsHandle(slug) {
      return slug is string
        && slug.size() > 0
        && slug.size() < 81
        && exists(handleDoc(slug))
        && get(handleDoc(slug)).data.uid == request.auth.uid;
    }

    function sourceListed() {
      return request.resource.data.source in ['google', 'apple', 'x', 'linked'];
    }

    // Older houses may have no source. Once one is stored, it stays.
    function sourceStable() {
      let hasNext = request.resource.data.keys().hasAny(['source']);
      let nextFine = !hasNext || request.resource.data.source == null || sourceListed();
      let unchanged = !resource.data.keys().hasAny(['source'])
        || resource.data.source == null
        || request.resource.data.source == resource.data.source;
      return nextFine && unchanged;
    }

    // Older houses may have no createdAt. Once stored, it cannot move.
    function createdAtStable() {
      let missing = !resource.data.keys().hasAny(['createdAt']);
      let backfill = missing && (
        !request.resource.data.keys().hasAny(['createdAt'])
        || request.resource.data.createdAt is number
      );
      let unchanged = !missing && request.resource.data.createdAt == resource.data.createdAt;
      return backfill || unchanged;
    }

    // A display change keeps the slug. A new slug must already belong to this person.
    function handleOk() {
      let same = resource.data.keys().hasAll(['handle'])
        && request.resource.data.handle == resource.data.handle;
      return same || ownsHandle(request.resource.data.handle);
    }

    match /users/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && ownsHandle(request.resource.data.handle)
        && sourceListed()
        && request.resource.data.createdAt is number;

      allow update: if owns(uid)
        && handleOk()
        && sourceStable()
        && createdAtStable();

      allow delete: if owns(uid);
    }

    match /handles/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt']);
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
